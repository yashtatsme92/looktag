# Names only. Copy to a private .env on the generic host. Never commit values.
# Render: set these in the Dashboard instead of a file.

DATABASE_URL=
DATABASE_SSL_NO_VERIFY=
DB_PROVIDER=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=
AUTH_PROVIDER=better-auth
AUTH_COOKIE_PREFIX=looktag
TRUSTED_PROXY_HEADER=x-forwarded-for
PLATFORM_CHROME=none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
ADMIN_EMAIL=
ADMIN_BOOTSTRAP=
ADMIN_BOOTSTRAP_PASSWORD=
PORT=8080
HOST=0.0.0.0
MIGRATE_ON_START=1
NODE_OPTIONS=--max-old-space-size=384
APP_DOMAIN=
LOOKTAG_IMAGE=ghcr.io/yashtatsme92/looktag:latest
