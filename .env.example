# Environment placeholders (no secrets)
#
# Prefer host-injected secrets in deploy. For local work you may copy this file
# to a private `.env` that is never committed, or export vars in your shell.
# See README.md and CONTRIBUTING.md.

# Neon pooled connection. The host must contain `-pooler`. Never commit a real URL.
# postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Certificates are verified. sslmode=no-verify or DATABASE_SSL_NO_VERIFY=1 disables that.
# Production refuses to boot when this is empty. LOOKTAG_ALLOW_EPHEMERAL_DB=1 opts in.
DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

ADMIN_EMAIL=
ADMIN_BOOTSTRAP=
ADMIN_BOOTSTRAP_PASSWORD=

XAI_API_KEY=
APP_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOOKTAG_NATIVE_URL=
VITE_AUTH_ENABLED=

# Providers. See docs/PROVIDERS.md. Defaults: postgres when DATABASE_URL is set,
# local storage, console errors, otlp telemetry, xai when XAI_API_KEY is set,
# brave shop search, console email (not wired).
DB_PROVIDER=
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=looktag-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
ERROR_PROVIDER=
SENTRY_DSN=
SENTRY_REGION=
TELEMETRY_PROVIDER=
APP_ENV=
AI_PROVIDER=
SHOP_SEARCH_PROVIDER=
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX=
EMAIL_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=


# Self-hosting. See docs/SELF_HOSTING.md. Names only.
AUTH_PROVIDER=
AUTH_COOKIE_PREFIX=
TRUSTED_PROXY_HEADER=
PLATFORM_CHROME=
GROK_PREVIEW_CLIENT_ID=
GROK_PREVIEW_CLIENT_SECRET=
MIGRATE_ON_START=
LOOKTAG_BUNDLE_PGLITE=
LOOKTAG_SKIP_BUILD_MIGRATE=
LOOKTAG_GIT_SHA=
SUGGEST_PROVIDER=
# 1 skips TLS verification for a local Postgres. Leave 0 in production.
DATABASE_SSL_NO_VERIFY=0
# 1 lets production boot on in-memory PGLite. Leave 0 so production refuses that.
LOOKTAG_ALLOW_EPHEMERAL_DB=0
# Alias of LOOKTAG_ALLOW_EPHEMERAL_DB. Leave empty.
ALLOW_EPHEMERAL_DB=

# Only when AUTH_PROVIDER=grok. Ignored on the default path.
GROK_CONNECTORS_URL=https://connectors.example.invalid
GROK_CONNECTOR_ACCESS_TOKEN=example-token-not-a-secret
GROK_GATE_ORIGIN=https://gate.example.invalid
GROK_PROJECT_ID=example-project

# Build and listen. node-server is the image default.
NITRO_PRESET=node-server
HOST=0.0.0.0
PORT=8080
NODE_OPTIONS=--max-old-space-size=384
# 1 logs the Nitro preset during build.
LOOKTAG_LOG_NITRO_PRESET=0

# Generic Docker host only. Not used on Render.
APP_DOMAIN=looktag.example
LOOKTAG_IMAGE=ghcr.io/yashtatsme92/looktag:latest
# CI deploy switch. render or ssh-compose.
DEPLOY_TARGET=render

# Local photo files. Not used when STORAGE_PROVIDER is s3 or r2.
STORAGE_LOCAL_ROOT=.data/storage

# Public origin for links and share cards. Example only.
VITE_APP_URL=https://looktag.example
VITE_PUBLIC_HOSTNAME=looktag.example
PUBLIC_ORIGIN=https://looktag.example
