# Environment placeholders (no secrets)
#
# Prefer host-injected secrets in deploy. For local work you may copy this file
# to a private `.env` that is never committed, or export vars in your shell.
# See README.md and CONTRIBUTING.md.

# Neon pooled connection. The host must contain `-pooler`. Never commit a real URL.
# postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Certificates are verified. sslmode=no-verify or DATABASE_SSL_NO_VERIFY=1 disables that.
# Production refuses to boot when this is empty. LOOKTAG_ALLOW_EPHEMERAL_DB=1 opts in.
DATABASE_URL=

BETTER_AUTH_SECRET=
# Public origin. Production: https://thelooktag.com (set APP_URL to the same).
BETTER_AUTH_URL=
# Canonical public origin. Every absolute URL (canonical, OG, sitemap, robots,
# share links, email links) is built from it. Production: https://thelooktag.com
APP_URL=
# Extra origins allowed to sign in (comma-separated), e.g. the previous host
# during a domain move: https://looktag.onrender.com
TRUSTED_ORIGINS=
# Optional: 1 = 301 any other host to APP_URL (auth on TRUSTED_ORIGINS exempt).
SITE_REDIRECT_TO_CANONICAL=
# Public contact mailbox (footer Contact link, legal pages).
CONTACT_EMAIL=hello@thelooktag.com
# Footer link ids to force on: impressum,privacy,terms,contact,about,instagram,tiktok,x,domain
# Ship empty: every footer link is off until switched on in Admin or listed here.
FOOTER_LINKS_ENABLED=
FOOTER_INSTAGRAM_URL=
FOOTER_TIKTOK_URL=
FOOTER_X_URL=

GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

ADMIN_EMAIL=
ADMIN_EMAILS=
ADMIN_BOOTSTRAP=
ADMIN_BOOTSTRAP_PASSWORD=

XAI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOOKTAG_NATIVE_URL=
VITE_AUTH_ENABLED=

# Providers. See docs/PROVIDERS.md. Defaults: postgres when DATABASE_URL is set,
# local storage, console errors, otlp telemetry, xai when XAI_API_KEY is set,
# brave shop search, console email (not wired).
DB_PROVIDER=
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=looktag-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
LOOK_IMAGE_AVIF=
ERROR_PROVIDER=
SENTRY_DSN=
SENTRY_REGION=
TELEMETRY_PROVIDER=
APP_ENV=
AI_PROVIDER=
SHOP_SEARCH_PROVIDER=
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX=
EMAIL_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

